{
  "name": "wireit-webpack-demo",
  "version": "1.0.0",
  "description": "Webpack and Wireit Performance Demo",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "webpack --mode production",
    "build:wireit": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "dev:wireit": "webpack serve --mode development",
    "generate": "node scripts/generate-components.mjs",
    "test:performance": "node scripts/test-performance.mjs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "wireit": {
    "build:wireit": {
      "command": "webpack --mode production",
      "files": [
        "src/**/*.js",
        "src/**/*.jsx",
        "src/**/*.ts",
        "src/**/*.tsx",
        "webpack.config.js",
        "tsconfig.json"
      ],
      "output": ["dist/**"]
    },
    "dev:wireit": {
      "command": "webpack serve --mode development",
      "files": [
        "src/**/*.js",
        "src/**/*.jsx",
        "src/**/*.ts",
        "src/**/*.tsx",
        "webpack.config.js",
        "tsconfig.json"
      ]
    }
  },
  "keywords": ["webpack", "wireit", "build", "performance"],
  "author": "",
  "license": "ISC"
}
