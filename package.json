{
  "scripts": {
    "build": "webpack --mode production",
    "build:wireit": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "dev:wireit": "webpack serve --mode development"
  },
  "wireit": {
    "build:wireit": {
      "command": "webpack --mode production",
      "files": [
        "src/**/*.js",
        "src/**/*.jsx",
        "src/**/*.ts",
        "src/**/*.tsx",
        "webpack.config.js",
        "tsconfig.json"
      ],
      "output": ["dist/**"]
    },
    "dev:wireit": {
      "command": "webpack serve --mode development",
      "files": [
        "src/**/*.js",
        "src/**/*.jsx",
        "src/**/*.ts",
        "src/**/*.tsx",
        "webpack.config.js",
        "tsconfig.json"
      ]
    }
  }
}
