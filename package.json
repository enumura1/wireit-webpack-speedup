{
  "scripts": {
    "build": "webpack --mode production",
    "build:wireit": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "dev:wireit": "webpack serve --mode development"
  },
  "wireit": {
    "build:wireit": {
      "command": "webpack --mode production",
      "files": [
        "src/**/*.js",
        "src/**/*.jsx",
        "src/**/*.ts",
        "src/**/*.tsx",
        "webpack.config.js",
        "tsconfig.json"
      ],
      "output": [
        "dist/**"
      ]
    },
    "dev:wireit": {
      "command": "webpack serve --mode development",
      "files": [
        "src/**/*.js",
        "src/**/*.jsx",
        "src/**/*.ts",
        "src/**/*.tsx",
        "webpack.config.js",
        "tsconfig.json"
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "babel-loader": "^10.0.0",
    "html-webpack-plugin": "^5.6.3",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.5",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1",
    "wireit": "^0.14.12"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
